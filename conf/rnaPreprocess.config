/*
 * =============================================================================
 * pacbioRNApreprocess/conf/rnaPreprocess.config — pipeline config
 * (between lrsShared.config and finalize.config)
 * =============================================================================
 * Kinnex (MAS-seq, IsoSeqX 12-plex) preprocessing of one Revio run:
 *   hifi_reads/<pool>.<movie>.hifi_reads.bcM000N.bam
 *     -> skera split -> lima -> per-sample uBAM with SM = NPN
 *
 * No server paths here: references, conda envs and report folders come from
 * lrsShared (Kinnex block, added to v2). Do not set those keys in this file - this
 * file is read after lrsShared and would override them.
 * =============================================================================
 */


// =============================================================================
// 1. CLI FLAGS
// =============================================================================
params {
    // ---- input -------------------------------------------------------------------
    // --samplesheet  LabWare metadata sheet of the run (the one autoLaunch uses for
    //                germline). DNA rows are ignored; RNA rows are the ones that
    //                carry an IsoSeqX barcode (see main.nf, SAMPLESHEET).
    // --runfolder    archived run folder: <raw data archive>/<year>/<runLabel>_<RUN_NAME>
    //                raw Kinnex BAMs are read from <runfolder>/hifi_reads/*.hifi_reads.bcM*.bam

    // ---- output ------------------------------------------------------------------
    // Default <runfolder>/rna_demultiplex: pacbioSomatic and pacbioGermline rna.nf
    // find the demultiplexed uBAMs there (glob **/*.lima.*.bam).
    // --outdir writes elsewhere (testing): then no completion flag in the run
    // folder and no copy to the shared QC report folder.

    // A sheet sample with no lima output (no reads for its barcode) fails the run
    // unless this is set. The manifest is written either way.
    allowMissingSamples = false

    // Demultiplexing is all-or-nothing: no 'cohort' mode here.
    errorMode           = 'strict'
}


// =============================================================================
// 2. SCRIPTS (lrsCustomTools release, resolved by lrsShared)
// =============================================================================
params {
    kinnexSummaryPy   = "${params.lrsCustomToolsBase}/summaryScripts/somaticRNA/kinnex_run_summary.py"
    kinnexSummaryHtml = "${params.lrsCustomToolsBase}/summaryScripts/somaticRNA/kinnex_run_summary_report_template.html"
}


// =============================================================================
// 3. DERIVED RUN CONTEXT + OUTPUT
// =============================================================================
if (!params.help && !(params.runfolder && params.samplesheet)) {
    throw new IllegalArgumentException(
        "pacbioRNApreprocess needs --samplesheet <LabWare metadata sheet> and --runfolder <archived run folder>")
}

params.runfolder     = params.runfolder ? params.runfolder.toString().replaceFirst(/\/+$/, '') : null
params.demuxDir      = params.outdir ? params.outdir.toString().replaceFirst(/\/+$/, '')
                                     : "${params.runfolder}/rna_demultiplex"
params.outputDirBase = params.demuxDir      // finalize.config: runInfo/<date>_<sheet>/NextflowReports under it
