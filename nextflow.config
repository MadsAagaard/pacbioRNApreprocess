/*
 * pacbioRNApreprocess — entry config
 * Run:  nextflow run MadsAagaard/pacbioRNApreprocess -r <tag> -profile slurm \
 *           --samplesheet <yymmdd>_<runName>_<NN>_metadata.txt --runfolder <archived run folder>
 *
 * Layers (same order in all LRS pipelines):
 *   lrsShared.config -> conf/rnaPreprocess.config -> finalize.config
 */

manifest {
    name       = 'MadsAagaard/pacbioRNApreprocess'
    mainScript = 'main.nf'
    version    = '2.0.2'
}

params {
    genome        = 'hg38'      // lrsShared needs one; preprocessing itself is genome-independent
    rundir        = "${launchDir.baseName}"

    // Declared here because conf/rnaPreprocess.config reads them, and a config
    // file cannot read an undefined param.
    runfolder     = null
    outdir        = null

    // Shared layer: a locally managed, versioned folder on the server, and the
    // only place server paths live (this repository holds none).
    // v2 with the Kinnex keys added (kinnexMas8Adapters, kinnexBarcodes12plex,
    // kinnexQcReportDir). main.nf checks the keys at launch.
    lrsSharedDir       = '/data/configs/lrsShared/v2'

    // lrsCustomTools release (kinnex_run_summary.py + template).
    // null = releases/current, resolved at launch.
    lrsCustomToolsBase = null
}

def supportedGenomes = ['hg38']

if (!(params.genome in supportedGenomes)) {
    throw new IllegalArgumentException(
        "Unknown --genome '${params.genome}'. Supported by pacbioRNApreprocess: ${supportedGenomes.join(', ')}")
}

def sharedConf = { String name ->
    def f = new File("${params.lrsSharedDir}/${name}")
    if (!f.exists()) {
        throw new IllegalStateException("Shared config not found: ${f}")
    }
    return f
}

includeConfig sharedConf('lrsShared.config')
includeConfig 'conf/rnaPreprocess.config'
includeConfig sharedConf('finalize.config')     // always last
